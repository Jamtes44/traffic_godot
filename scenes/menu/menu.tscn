[node name="Config" type="VBoxContainer" parent="UI/Pantalla/Contenido"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Subtitulo" type="Label" parent="UI/Pantalla/Contenido/Config"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Configuración"
horizontal_alignment = 1

[node name="BrilloLabel" type="Label" parent="UI/Pantalla/Contenido/Config"]
unique_name_in_owner = true
layout_mode = 2
text = "Brillo: 100%"
horizontal_alignment = 1

[node name="Brillo" type="HSlider" parent="UI/Pantalla/Contenido/Config"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
min_value = 0.5
max_value = 1.5
step = 0.05
value = 1.0

[node name="VolumenLabel" type="Label" parent="UI/Pantalla/Contenido/Config"]
unique_name_in_owner = true
layout_mode = 2
text = "Volumen: 80%"
horizontal_alignment = 1

[node name="Volumen" type="HSlider" parent="UI/Pantalla/Contenido/Config"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 16)
layout_mode = 2
max_value = 1.0
step = 0.05
value = 0.8

[node name="Volver" type="Button" parent="UI/Pantalla/Contenido/Config"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
text = "Volver"

[connection signal="pressed" from="UI/Pantalla/Contenido/Inicio/Iniciar" to="." method="start"]
[connection signal="pressed" from="UI/Pantalla/Contenido/Inicio/Configuracion" to="." method="open_config"]
[connection signal="pressed" from="UI/Pantalla/Contenido/Inicio/Salir" to="." method="quit_game"]
[connection signal="value_changed" from="UI/Pantalla/Contenido/Config/Brillo" to="." method="_on_brillo_changed"]
[connection signal="value_changed" from="UI/Pantalla/Contenido/Config/Volumen" to="." method="_on_volumen_changed"]
[connection signal="pressed" from="UI/Pantalla/Contenido/Config/Volver" to="." method="close_config"]
