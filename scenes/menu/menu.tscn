[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/menu/menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/road/road.tscn" id="2"]
[ext_resource type="Texture2D" path="res://art/gas.png" id="3"]
[ext_resource type="Texture2D" path="res://art/vive.png" id="4"]
[ext_resource type="Texture2D" path="res://art/escudo.png" id="5"]
[ext_resource type="PackedScene" path="res://scenes/ui/logo.tscn" id="6"]
[ext_resource type="Texture2D" path="res://art/gamedev_logo.png" id="7"]

[sub_resource type="StyleBoxFlat" id="tarjeta"]
bg_color = Color(1, 1, 1, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="Menu" type="Node2D"]
script = ExtResource("1")

[node name="Camara" type="Camera2D" parent="."]
position = Vector2(90, 160)

[node name="Carretera" parent="." instance=ExtResource("2")]
auto_speed = 40.0

[node name="UI" type="CanvasLayer" parent="."]

[node name="Pantalla" type="Control" parent="UI"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Logo" parent="UI/Pantalla" instance=ExtResource("6")]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -75.0
offset_top = 6.0
offset_right = 75.0
offset_bottom = 90.0
animate = true

[node name="Fondo" type="Panel" parent="UI/Pantalla"]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -72.0
offset_top = 96.0
offset_right = 72.0
offset_bottom = 266.0
mouse_filter = 2

[node name="Contenido" type="VBoxContainer" parent="UI/Pantalla"]
layout_mode = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -60.0
offset_top = 104.0
offset_right = 60.0
offset_bottom = 306.0
theme_override_constants/separation = 6

[node name="GameDev" type="Panel" parent="UI/Pantalla"]
clip_children = 1
layout_mode = 1
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = -50.0
offset_right = 50.0
offset_bottom = -6.0
mouse_filter = 2
theme_override_styles/panel = SubResource("tarjeta")

[node name="Imagen" type="TextureRect" parent="UI/Pantalla/GameDev"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
texture = ExtResource("7")
expand_mode = 1
stretch_mode = 5

[node name="Inicio" type="VBoxContainer" parent="UI/Pantalla/Contenido"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="Record" type="Label" parent="UI/Pantalla/Contenido/Inicio"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.941, 0.569, 0.122, 1)
text = "Récord: 0 m"
horizontal_alignment = 1

[node name="Iniciar" type="Button" parent="UI/Pantalla/Contenido/Inicio"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
text = "Iniciar"

[node name="Configuracion" type="Button" parent="UI/Pantalla/Contenido/Inicio"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
text = "Configuración"

[node name="Salir" type="Button" parent="UI/Pantalla/Contenido/Inicio"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
text = "Salir"

[node name="Ayuda" type="Label" parent="UI/Pantalla/Contenido/Inicio"]
