[node name="Juego" type="Node2D"]
script = ExtResource("1")

[node name="Camara" type="Camera2D" parent="."]
position = Vector2(90, 160)

[node name="Carretera" parent="." instance=ExtResource("2")]

[node name="Objetos" type="Node2D" parent="."]

[node name="Moto" parent="." instance=ExtResource("3")]
position = Vector2(90, 270)

[node name="Spawner" type="Node" parent="." node_paths=PackedStringArray("target")]
script = ExtResource("4")
obstacles = Array[PackedScene]([ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("9")])
power_ups = Array[PackedScene]([ExtResource("10"), ExtResource("10"), ExtResource("11"), ExtResource("12")])
