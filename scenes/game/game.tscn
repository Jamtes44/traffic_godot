[node name="Motor" type="AudioStreamPlayer" parent="."]
bus = &"Motor"

[node name="UI" type="CanvasLayer" parent="."]

[node name="HUD" parent="UI" instance=ExtResource("13")]

[node name="FinRecorrido" parent="UI" instance=ExtResource("14")]
visible = false

[node name="Instrucciones" type="Panel" parent="UI"]
