; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gamedev - Traffic Runner"
run/main_scene="res://scenes/menu/menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6")
boot_splash/bg_color=Color(0.055, 0.13, 0.15, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://art/logo.png"
config/icon="res://art/icon.png"

[autoload]

Save="*res://autoload/save.gd"
Audio="*res://autoload/audio.gd"

[display]

window/size/viewport_width=180
window/size/viewport_height=320
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[gui]

theme/custom="res://scenes/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
